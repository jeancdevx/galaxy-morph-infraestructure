{
  "name": "results-dispatcher",
  "version": "1.0.0",
  "description": "MSK galaxy.results consumer: calls AppSync mutation and updates DynamoDB job status",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --platform=node --target=node22 --outfile=dist/index.js && cd dist && zip -r function.zip index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "2.33.0",
    "@aws-lambda-powertools/metrics": "2.33.0",
    "@aws-lambda-powertools/tracer": "2.33.0",
    "@aws-sdk/client-dynamodb": "3.1053.0",
    "@aws-sdk/lib-dynamodb": "3.1051.0",
    "@galaxy-morph/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.161",
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "3.2.2",
    "esbuild": "0.28.0",
    "typescript": "6.0.3",
    "vitest": "3.2.2"
  }
}
