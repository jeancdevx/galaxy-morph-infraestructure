    "@aws-sdk/client-dynamodb": "3.1050.0",
    "@aws-sdk/lib-dynamodb": "3.1050.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.161",
    "@types/node": "25.9.1",
    "esbuild": "0.28.0",
    "typescript": "6.0.3"
  }
}
