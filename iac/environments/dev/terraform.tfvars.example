aws_region  = "us-east-2"
aws_profile = "your-sso-profile"

project_name = "galaxy-morph"
environment  = "dev"

vpc_cidr_block       = "10.20.0.0/16"
availability_zones   = ["us-east-2a", "us-east-2b"]
public_subnet_cidrs  = ["10.20.1.0/24", "10.20.2.0/24"]
private_subnet_cidrs = ["10.20.11.0/24", "10.20.12.0/24"]
enable_nat_gateway   = true

msk_port             = 9098
sagemaker_https_port = 443

enable_s3_gateway_endpoint                  = true
enable_dynamodb_gateway_endpoint            = true
enable_sqs_interface_endpoint               = true
enable_sagemaker_runtime_interface_endpoint = true
enable_private_dns                          = true

jobs_table_name         = "galaxy-morph-jobs"
jobs_table_hash_key     = "pk"
jobs_table_range_key    = "sk"
enable_jobs_table_pitr  = true

ingestion_queue_name                      = "galaxy-morph-ingestion"
ingestion_dlq_name                        = "galaxy-morph-ingestion-dlq"
ingestion_queue_visibility_timeout_seconds = 120
ingestion_queue_message_retention_seconds  = 345600
ingestion_queue_max_receive_count          = 5

ingestion_topic_name            = "galaxy.ingestion"
results_topic_name              = "galaxy.results"
kafka_topic_partitions          = 24
kafka_topic_replication_factor  = 2
kafka_ingestion_retention_ms    = 604800000
kafka_results_retention_ms      = 259200000

enable_msk_connect_connector    = false
msk_connect_custom_plugin_arn   = null
msk_connect_custom_plugin_revision = null
msk_connect_kafkaconnect_version = "2.7.1"
msk_connect_mcu_count           = 1
msk_connect_min_worker_count    = 2
msk_connect_max_worker_count    = 10
msk_connect_tasks_max           = 16
msk_connect_log_retention_days  = 14

msk_cluster_name = null

emr_enable_initial_capacity       = false
emr_release_label                 = "emr-7.13.0"
emr_serverless_log_prefix         = "emr-serverless/logs"
emr_log_retention_days            = 14
emr_idle_timeout_minutes          = 15
emr_initial_driver_worker_count   = 1
emr_initial_driver_cpu            = "2 vCPU"
emr_initial_driver_memory         = "4 GB"
emr_initial_executor_worker_count = 6
emr_initial_executor_cpu          = "2 vCPU"
emr_initial_executor_memory       = "4 GB"
emr_maximum_cpu                   = "1000 vCPU"
emr_maximum_memory                = "8000 GB"
emr_maximum_disk                  = "20000 GB"

images_bucket_name      = "galaxy-morph-images"
checkpoints_bucket_name = "galaxy-morph-checkpoints"
models_bucket_name      = "galaxy-morph-models"
raw_bucket_name         = "galaxy-morph-raw"

# Replace with concrete ARN once AppSync API exists.
appsync_api_arn = "*"

# SageMaker — update sagemaker_model_artifact_s3_uri after running: make upload (services/ml/model_bundle)
sagemaker_model_artifact_s3_uri          = "s3://galaxy-morph-models/sagemaker/galaxy-classifier/efficientnet_b3/v1/model.tar.gz"
sagemaker_image_uri                      = "763104351884.dkr.ecr.us-east-2.amazonaws.com/pytorch-inference:2.3.0-cpu-py311-ubuntu20.04-sagemaker"
sagemaker_instance_type                  = "ml.m5.large"
sagemaker_initial_instance_count         = 1
sagemaker_enable_vpc_config              = false
sagemaker_enable_autoscaling             = false
sagemaker_autoscaling_min_capacity       = 1
sagemaker_autoscaling_max_capacity       = 2
sagemaker_autoscaling_target_invocations = 10
